{
  "datasets": [
    {
      "name": "listings",
      "displayName": "Listings",
      "queryLines": [
        "SELECT\n",
        "  property_id, source, property_type, neighborhood, bedrooms, bathrooms, parking, url,\n",
        "  first_seen_date, last_seen_date, days_seen,\n",
        "  price_cop, last_price_cop, price_per_m2, area_m2,\n",
        "  COALESCE(CAST(estrato AS STRING), 'unknown') AS estrato_label,\n",
        "  CASE WHEN bedrooms IS NULL THEN 'unknown' WHEN bedrooms >= 5 THEN '5+' ELSE CAST(bedrooms AS STRING) END AS bedrooms_label,\n",
        "  CASE WHEN last_seen_date >= date_sub(current_date(), 7) THEN 1 ELSE 0 END AS still_listed,\n",
        "  LEAST(price_cop / 1e6, 30) AS rent_millions_capped,\n",
        "  CASE WHEN area_m2 <= 400 AND price_cop <= 30000000 THEN area_m2 END AS area_m2_chart,\n",
        "  CASE WHEN area_m2 <= 400 AND price_cop <= 30000000 THEN price_cop / 1e6 END AS rent_millions_chart,\n",
        "  CASE WHEN good_deal THEN 'Good deals only' ELSE 'Other listings' END AS deal_filter,\n",
        "  CASE WHEN good_deal THEN 'Good deal' ELSE '' END AS deal_label,\n",
        "  sector_code, barrio, shape\n",
        "FROM gold_rent_listings\n",
        "LEFT JOIN (SELECT source AS deal_source, property_id AS deal_id, good_deal FROM rent_predictions) d\n",
        "  ON d.deal_source = source AND d.deal_id = property_id\n",
        "LEFT JOIN (SELECT neighborhood AS loc_neighborhood, sector_code FROM neighborhood_locations) loc\n",
        "  ON loc.loc_neighborhood = neighborhood\n",
        "LEFT JOIN (SELECT sector_code AS shape_code, sector_name AS barrio,\n",
        "    ST_Simplify(ST_GeomFromGeoJSON(geojson), 0.0001) AS shape FROM barrio_shapes) s\n",
        "  ON s.shape_code = loc.sector_code\n",
        "ORDER BY last_seen_date DESC, first_seen_date DESC\n"
      ],
      "columns": [
        {
          "displayName": "Listings",
          "expression": "COUNT(`property_id`)"
        },
        {
          "displayName": "Median rent",
          "expression": "MEDIAN(`price_cop`)"
        },
        {
          "displayName": "Median rent per m2",
          "expression": "MEDIAN(`price_per_m2`)"
        },
        {
          "displayName": "Median rent for map",
          "expression": "LEAST(MEDIAN(`price_cop`), 8000000)"
        }
      ]
    }
  ],
